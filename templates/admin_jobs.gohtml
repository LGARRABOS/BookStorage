{{ define "admin_jobs" }}
<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {{template "site_head_icons" .}}
    <title>{{ t .T "admin.jobs.title" }} - BookStorage</title>
    <link rel="stylesheet" href="/static/css/base.css">
    <link rel="stylesheet" href="/static/css/mobile.css">
    <link rel="stylesheet" href="/static/css/admin.css">
    <script src="/static/js/appearance-init.js"></script>
    <style>
        .jobs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin: 1.25rem 0; }
        .jobs-kpi { background: var(--surface); border: 1px solid var(--border-subtle); border-radius: 0.85rem; padding: 0.9rem 1rem; }
        .jobs-kpi-label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem; }
        .jobs-kpi-value { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        .jobs-status { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }
        .jobs-dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #94a3b8; }
        .jobs-dot--on { background: #16a34a; box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2); }
        .jobs-dot--warn { background: #d97706; box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.2); }
        .jobs-meta { color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; }
        .jobs-actions { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
    </style>
</head>
<body>
    {{ template "hub_topbar" . }}
    {{ template "admin_update_banner" . }}
    <main class="page-body">
        <div class="container content-card">
            <section class="page-section">
                <header class="section-header">
                    <h1>{{ t .T "admin.jobs.title" }}</h1>
                    {{ template "admin_tabs" . }}
                </header>
                <p class="jobs-meta">{{ t .T "admin.jobs.intro" }}</p>
                {{ if .JobsStarted }}
                <p class="badge success" style="margin-top:0.75rem;">{{ t .T "admin.jobs.started" }}</p>
                {{ end }}

                <h2 style="font-size:1.05rem;margin:1.5rem 0 0.5rem;">{{ t .T "admin.jobs.covers.title" }}</h2>
                <p class="jobs-meta">{{ t .T "admin.jobs.covers.desc" }}</p>

                <div class="jobs-grid" id="jobs-kpis">
                    <div class="jobs-kpi">
                        <span class="jobs-kpi-label">{{ t .T "admin.jobs.covers.missing" }}</span>
                        <span class="jobs-kpi-value" data-kpi="global_missing">{{ .CoverGlobalMissing }}</span>
                    </div>
                    <div class="jobs-kpi">
                        <span class="jobs-kpi-label">{{ t .T "admin.jobs.covers.pending" }}</span>
                        <span class="jobs-kpi-value" data-kpi="pending_now">{{ .CoverJob.PendingNow }}</span>
                    </div>
                    <div class="jobs-kpi">
                        <span class="jobs-kpi-label">{{ t .T "admin.jobs.covers.filled" }}</span>
                        <span class="jobs-kpi-value" data-kpi="filled">{{ .CoverJob.Filled }}</span>
                    </div>
                    <div class="jobs-kpi">
                        <span class="jobs-kpi-label">{{ t .T "admin.jobs.covers.eta" }}</span>
                        <span class="jobs-kpi-value" data-kpi="eta_human">{{ if .CoverETAHuman }}{{ .CoverETAHuman }}{{ else }}—{{ end }}</span>
                    </div>
                </div>

                <p class="jobs-status" id="jobs-status-line">
                    <span class="jobs-dot{{ if .CoverJob.RateLimited }} jobs-dot--warn{{ else if .CoverJobRunning }} jobs-dot--on{{ end }}" id="jobs-dot"></span>
                    <span id="jobs-status-text">
                        {{ if .CoverJob.RateLimited }}{{ t .T "admin.jobs.covers.rate_limited" }}
                        {{ else if .CoverJobRunning }}{{ t .T "admin.jobs.covers.running" }}
                        {{ else if gt .CoverGlobalMissing 0 }}{{ t .T "admin.jobs.covers.idle_pending" }}
                        {{ else }}{{ t .T "admin.jobs.covers.idle" }}{{ end }}
                    </span>
                </p>
                <p class="jobs-meta" id="jobs-detail">
                    {{ if .CoverJobRunning }}
                        {{ if .CoverJob.Username }}{{ t .T "admin.jobs.covers.user" }}: <strong>{{ .CoverJob.Username }}</strong> (#{{ .CoverJob.UserID }}) · {{ end }}
                        {{ if .CoverJob.CurrentTitle }}{{ t .T "admin.jobs.covers.current" }}: <em>{{ .CoverJob.CurrentTitle }}</em> · {{ end }}
                        {{ t .T "admin.jobs.covers.processed" }}: {{ .CoverJob.Processed }}
                        ({{ .CoverJob.Filled }} {{ t .T "admin.jobs.covers.ok" }} / {{ .CoverJob.Skipped }} {{ t .T "admin.jobs.covers.skip" }})
                    {{ end }}
                </p>
                <p class="jobs-meta" id="jobs-queue" {{ if not .CoverJob.QueuedUsers }}hidden{{ end }}>
                    {{ t .T "admin.jobs.covers.queued" }}: <span id="jobs-queue-ids">{{ range $i, $uid := .CoverJob.QueuedUsers }}{{ if $i }}, {{ end }}#{{ $uid }}{{ end }}</span>
                </p>

                <div class="jobs-actions">
                    <form method="POST" action="/admin/jobs/covers/run">
                        <button type="submit" class="btn btn-primary" {{ if eq .CoverGlobalMissing 0 }}disabled{{ end }}>{{ t .T "admin.jobs.covers.run" }}</button>
                    </form>
                    <span class="jobs-meta">{{ t .T "admin.jobs.covers.run_hint" }}</span>
                </div>
            </section>
        </div>
    </main>
    <script nonce="{{ .CSPNonce }}">
    (function () {
        var i18n = {
            running: {{ jsstr (t .T "admin.jobs.covers.running") }},
            idle: {{ jsstr (t .T "admin.jobs.covers.idle") }},
            idlePending: {{ jsstr (t .T "admin.jobs.covers.idle_pending") }},
            rateLimited: {{ jsstr (t .T "admin.jobs.covers.rate_limited") }},
            user: {{ jsstr (t .T "admin.jobs.covers.user") }},
            current: {{ jsstr (t .T "admin.jobs.covers.current") }},
            processed: {{ jsstr (t .T "admin.jobs.covers.processed") }},
            ok: {{ jsstr (t .T "admin.jobs.covers.ok") }},
            skip: {{ jsstr (t .T "admin.jobs.covers.skip") }},
            queued: {{ jsstr (t .T "admin.jobs.covers.queued") }}
        };
        function setText(sel, val) {
            var el = document.querySelector(sel);
            if (el) el.textContent = val == null || val === '' ? '—' : String(val);
        }
        function refresh() {
            fetch('/api/admin/jobs', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) {
                    if (!data || !data.covers) return;
                    var c = data.covers;
                    setText('[data-kpi="global_missing"]', c.global_missing);
                    setText('[data-kpi="pending_now"]', c.pending_now);
                    setText('[data-kpi="filled"]', c.filled);
                    setText('[data-kpi="eta_human"]', data.eta_human || '—');
                    var dot = document.getElementById('jobs-dot');
                    var status = document.getElementById('jobs-status-text');
                    if (dot) {
                        dot.className = 'jobs-dot';
                        if (c.rate_limited) dot.classList.add('jobs-dot--warn');
                        else if (c.running) dot.classList.add('jobs-dot--on');
                    }
                    if (status) {
                        if (c.rate_limited) status.textContent = i18n.rateLimited;
                        else if (c.running) status.textContent = i18n.running;
                        else if (c.global_missing > 0) status.textContent = i18n.idlePending;
                        else status.textContent = i18n.idle;
                    }
                    var detail = document.getElementById('jobs-detail');
                    if (detail) {
                        if (c.running) {
                            var parts = [];
                            if (c.username) parts.push(i18n.user + ': ' + c.username + ' (#' + c.user_id + ')');
                            if (c.current_title) parts.push(i18n.current + ': ' + c.current_title);
                            parts.push(i18n.processed + ': ' + c.processed + ' (' + c.filled + ' ' + i18n.ok + ' / ' + c.skipped + ' ' + i18n.skip + ')');
                            detail.textContent = parts.join(' · ');
                        } else {
                            detail.textContent = '';
                        }
                    }
                    var queue = document.getElementById('jobs-queue');
                    var queueIds = document.getElementById('jobs-queue-ids');
                    if (queue && queueIds) {
                        if (c.queued_user_ids && c.queued_user_ids.length) {
                            queue.hidden = false;
                            queueIds.textContent = c.queued_user_ids.map(function (id) { return '#' + id; }).join(', ');
                        } else {
                            queue.hidden = true;
                        }
                    }
                }).catch(function () {});
        }
        setInterval(refresh, 3000);
    })();
    </script>
</body>
</html>
{{ end }}
