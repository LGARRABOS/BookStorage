{{ define "add_bd" }}
<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#4f46e5">
    {{ template "site_head_icons" . }}
    <title>{{ t .T "bd.add.title" }} - BookStorage</title>
    <link rel="stylesheet" href="/static/css/base.css">
    <link rel="stylesheet" href="/static/css/mobile.css">
    <script src="/static/js/appearance-init.js"></script>
    {{ template "bd_form_styles" . }}
</head>
<body>
    {{ template "bd_topbar" . }}
    <main class="page-body">
        <div class="container form-page">
            <div class="form-header">
                <div class="form-header-title"><h1>➕ {{ t .T "bd.add.title" }}</h1></div>
                <a href="/bd/dashboard" class="btn btn-secondary">← {{ t .T "common.back" }}</a>
            </div>

            {{ if .ErrorExists }}
            <div class="form-alert form-alert--error" role="alert">{{ t .T "bd.error.exists" }}</div>
            {{ end }}

            <div class="form-card">
                <div class="form-card-header">
                    <div class="icon purple">🔍</div>
                    <div><h2>{{ t .T "bd.catalog.search.title" }}</h2><span>{{ t .T "bd.catalog.search.desc" }}</span></div>
                </div>
                <div class="form-group">
                    <label for="catalog-search">{{ t .T "bd.catalog.search.label" }}</label>
                    <input type="text" id="catalog-search" placeholder="{{ t .T "bd.catalog.search.placeholder" }}" autocomplete="off">
                </div>
                <div id="catalog-results" class="catalog-results"></div>
            </div>

            <form method="POST" enctype="multipart/form-data" id="bd-form">
                <input type="hidden" name="catalog_source" id="catalog_source" value="{{ if .PrefillCatalogSource }}{{ .PrefillCatalogSource }}{{ end }}">
                <input type="hidden" name="catalog_external_id" id="catalog_external_id" value="{{ if .PrefillCatalogExternalID }}{{ .PrefillCatalogExternalID }}{{ end }}">
                {{ template "bd_form_fields" . }}
                <div class="form-actions">
                    <a href="/bd/dashboard" class="btn btn-secondary">{{ t .T "common.cancel" }}</a>
                    <div class="form-actions-right">
                        <button type="submit" class="btn btn-primary">✓ {{ t .T "bd.form.submit.add" }}</button>
                    </div>
                </div>
            </form>
        </div>
    </main>

    <footer class="page-footer"><div class="container"><p>BookStorage · <a href="/legal" style="color: var(--text-muted);">{{ t .T "footer.legal" }}</a></p></div></footer>

    <script src="/static/js/appearance.js"></script>
    {{ template "bd_form_scripts" . }}
    <script nonce="{{ .CSPNonce }}">
        var catalogSearchEmptyMsg = {{ jsstr (t .T "bd.catalog.search.empty") }};
        var catalogSearchErrMsg = {{ jsstr (t .T "bd.catalog.search.error") }};
        var alreadyInLibraryMsg = {{ jsstr (t .T "bd.in_library") }};
        (function() {
            var searchTimer;
            var searchInput = document.getElementById('catalog-search');
            var resultsEl = document.getElementById('catalog-results');
            if (!searchInput) return;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimer);
                var q = this.value.trim();
                if (q.length < 2) { resultsEl.classList.remove('visible'); resultsEl.innerHTML = ''; return; }
                searchTimer = setTimeout(function() {
                    fetch('/api/bd/catalog/search?q=' + encodeURIComponent(q))
                        .then(function(r) {
                            if (r.status === 401) { window.location.href = '/login?expired=1'; return Promise.reject(); }
                            return r.json();
                        })
                        .then(function(data) {
                            var list = data.results || [];
                            resultsEl.innerHTML = '';
                            if (!list.length) {
                                var msg = data.openlibrary_error === 'rate_limit' ? catalogSearchErrMsg : catalogSearchEmptyMsg;
                                resultsEl.innerHTML = '<div class="catalog-result-item" style="cursor:default;color:var(--text-muted);">' + msg + '</div>';
                            } else {
                                list.forEach(function(item) {
                                    var el = document.createElement('div');
                                    el.className = 'catalog-result-item' + (item.in_library ? ' is-in-library' : '');
                                    var cover = item.image_url
                                        ? '<img src="' + item.image_url + '" alt="">'
                                        : '<span class="no-cover">📘</span>';
                                    var meta = (item.bd_type || '') + (item.first_publish_year ? ' · ' + item.first_publish_year : '') + (item.is_adult ? ' · 18+' : '');
                                    var badgeClass = item.in_library ? 'badge in-library' : 'badge';
                                    var badgeText = item.in_library ? alreadyInLibraryMsg : 'Open Library';
                                    el.innerHTML = cover + '<div class="info"><strong></strong><span></span></div><span class="' + badgeClass + '"></span>';
                                    el.querySelector('strong').textContent = item.title || '';
                                    el.querySelector('.info span').textContent = meta;
                                    el.querySelector('.badge').textContent = badgeText;
                                    if (item.in_library) {
                                        el.addEventListener('click', function() {
                                            if (item.library_id) window.location.href = '/bd/edit/' + item.library_id;
                                        });
                                    } else {
                                        el.addEventListener('click', function() {
                                            document.getElementById('title').value = item.title || '';
                                            document.getElementById('image_url').value = item.image_url || '';
                                            if (item.bd_type) document.getElementById('bd_type').value = item.bd_type;
                                            document.getElementById('is_adult').checked = !!item.is_adult;
                                            document.getElementById('catalog_source').value = item.source || 'openlibrary';
                                            document.getElementById('catalog_external_id').value = item.external_id || '';
                                            if (item.authors && item.authors.length) {
                                                var notesEl = document.getElementById('notes');
                                                if (notesEl && !notesEl.value) notesEl.value = item.authors.join(', ');
                                            }
                                            if (item.image_url) previewImageUrl(document.getElementById('image_url'));
                                            resultsEl.classList.remove('visible');
                                            searchInput.value = '';
                                        });
                                    }
                                    resultsEl.appendChild(el);
                                });
                            }
                            resultsEl.classList.add('visible');
                        })
                        .catch(function() { resultsEl.classList.remove('visible'); });
                }, 300);
            });
            document.addEventListener('click', function(e) {
                if (!resultsEl.contains(e.target) && e.target.id !== 'catalog-search') resultsEl.classList.remove('visible');
            });
        })();
    </script>
</body>
</html>
{{ end }}
