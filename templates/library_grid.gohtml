{{ define "library_grid" }}
<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0f1419">
    {{ template "site_head_icons" . }}
    <title>{{ .Furniture.Name }} - BookStorage</title>
    <link rel="stylesheet" href="/static/css/base.css">
    <link rel="stylesheet" href="/static/css/mobile.css">
    <link rel="stylesheet" href="/static/css/library-grid.css?v=3">
    <script src="/static/js/appearance-init.js"></script>
</head>
<body class="library-iso-body">
    {{ template "library_topbar" . }}
    <main class="page-body library-iso-page">
        <div class="library-iso-layout"
             id="library-grid-root"
             data-furniture-id="{{ .Furniture.ID }}"
             data-i18n-empty="{{ t .T "library.case.empty" }}"
             data-i18n-add="{{ t .T "library.case.add" }}"
             data-i18n-remove="{{ t .T "library.case.remove" }}"
             data-i18n-up="{{ t .T "library.case.up" }}"
             data-i18n-down="{{ t .T "library.case.down" }}"
             data-i18n-pick="{{ t .T "library.iso.pick" }}"
             data-i18n-panel-title="{{ t .T "library.iso.panel_title" }}"
             data-i18n-volumes="{{ t .T "library.furniture.volumes" }}">

            <section class="library-iso-main">
                <header class="library-iso-header">
                    <div>
                        <h1>{{ .Furniture.Name }}</h1>
                        {{ if .Furniture.RoomLabel.Valid }}<p>{{ .Furniture.RoomLabel.String }}</p>{{ end }}
                        <div class="library-iso-stat">
                            <strong id="library-iso-count">{{ len .Placements }}</strong>
                            <span>{{ t .T "library.furniture.volumes" }}</span>
                        </div>
                    </div>
                    <div class="library-iso-header-actions">
                        <a href="/library/furniture/{{ .Furniture.ID }}/edit" class="btn btn-secondary">{{ t .T "library.furniture.edit" }}</a>
                        <a href="/library/" class="btn btn-secondary">← {{ t .T "common.back" }}</a>
                    </div>
                </header>

                <div class="library-iso-stage-wrap">
                    <div class="library-iso-zoom" aria-label="Zoom">
                        <button type="button" id="library-zoom-in" title="+">+</button>
                        <button type="button" id="library-zoom-out" title="−">−</button>
                    </div>
                    <div class="library-iso-stage" id="library-iso-stage">
                        <p class="library-empty">{{ t .T "library.grid.loading" }}</p>
                    </div>
                </div>
            </section>

            <aside class="library-iso-panel" id="library-case-panel" aria-live="polite">
                <header class="library-iso-panel-head">
                    <h2 id="library-case-panel-title">{{ t .T "library.iso.panel_title" }}</h2>
                    <button type="button" class="btn btn-secondary btn-sm" id="library-case-panel-close" hidden aria-label="{{ t .T "common.close" }}">✕</button>
                </header>
                <p class="library-iso-panel-placeholder" id="library-panel-placeholder">{{ t .T "library.iso.pick" }}</p>
                <div id="library-case-panel-list" hidden></div>
                <div class="library-case-add" id="library-case-add" hidden>
                    <div class="library-case-add-tabs">
                        <button type="button" class="btn btn-secondary btn-sm is-active" data-kind="manga">{{ t .T "library.media.manga" }}</button>
                        <button type="button" class="btn btn-secondary btn-sm" data-kind="bd">{{ t .T "library.media.bd" }}</button>
                    </div>
                    <label class="library-case-add-search">
                        <span>{{ t .T "library.case.search_work" }}</span>
                        <input type="search" id="library-work-q" autocomplete="off">
                    </label>
                    <label class="library-case-add-volume" id="library-volume-wrap">
                        <span>{{ t .T "library.case.volume" }}</span>
                        <input type="number" id="library-work-volume" min="1" value="1">
                    </label>
                    <ul id="library-work-results" class="library-work-results"></ul>
                </div>
            </aside>
        </div>
    </main>

    <footer class="page-footer"><div class="container"><p>BookStorage</p></div></footer>
    <script src="/static/js/appearance.js"></script>
    <script src="/static/js/library-grid.js?v=2"></script>
</body>
</html>
{{ end }}
