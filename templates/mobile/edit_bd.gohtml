{{ define "mobile_edit_bd" }}
<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
    {{ template "mobile_shell_head" . }}
    <title>{{ t .T "bd.edit.title" }} - BookStorage</title>
    {{ template "bd_form_styles" . }}
</head>
<body class="mobile-app-body">
    {{ template "mobile_topbar" . }}
    {{ template "mobile_settings_sheet" . }}

    <main class="page-body mobile-page">
        <div class="container form-page">
            {{ if .ErrorExists }}
            <div class="form-alert form-alert--error" role="alert">{{ t .T "bd.error.exists" }}</div>
            {{ end }}
            {{ template "edit_bd_form" . }}
        </div>
    </main>

    {{ template "mobile_bottom_nav" . }}
    {{ template "mobile_shell_scripts" . }}
    {{ template "bd_form_scripts" . }}
    <script nonce="{{ .CSPNonce }}">
        var deleteConfirmMsg = {{ jsstr (t .T "bd.delete.confirm") }};
        var delBtn = document.getElementById('bd-delete-btn');
        if (delBtn) {
            delBtn.addEventListener('click', function() {
                var id = delBtn.getAttribute('data-id');
                var title = delBtn.getAttribute('data-title') || '';
                if (!confirm(deleteConfirmMsg.replace('%s', title))) return;
                fetch('/api/bd/delete/' + id, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function(r) { return r.json(); })
                    .then(function(data) { if (data && data.ok) window.location.href = '/bd/dashboard'; });
            });
        }
    </script>
</body>
</html>
{{ end }}
