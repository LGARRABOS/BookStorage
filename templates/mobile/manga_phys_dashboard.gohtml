{{ define "mobile_manga_phys_dashboard" }}
<!DOCTYPE html>
<html lang="{{ .Lang }}">
<head>
    {{ template "mobile_shell_head" . }}
    <title>{{ t .T "manga_phys.title" }} - BookStorage</title>
    <link rel="stylesheet" href="/static/css/dashboard-mobile.css?v=17">
    <style>
        .bd-mobile-row { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit; }
        .bd-mobile-row-main { display: flex; align-items: center; gap: 0.75rem; flex: 1; min-width: 0; text-decoration: none; color: inherit; }
    </style>
</head>
<body class="mobile-app-body mobile-dashboard-body">
    {{ template "mobile_topbar" . }}

    <div class="mobile-search-inline" id="mobile-search-inline">
        <div class="container">
            <div class="mobile-search-bar">
                <svg class="mobile-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input id="mobile-manga-phys-search" type="search" placeholder="{{ t .T "manga_phys.search.placeholder" }}" value="{{ .SearchQuery }}" autocomplete="off" enterkeyhint="search" aria-label="{{ t .T "manga_phys.search.placeholder" }}">
            </div>
        </div>
    </div>

    <main class="page-body mobile-page mobile-dashboard-page">
        <div class="container">
            {{ template "import_notice" . }}

            <div class="mobile-collection-header">
                <div class="mobile-collection-tabs" id="mobile-manga-phys-quick-filters" role="tablist">
                    <button type="button" class="mobile-collection-tab is-active" data-status="" role="tab" aria-selected="true">{{ t .T "mobile.manga_phys.tab.all" }}</button>
                    <button type="button" class="mobile-collection-tab" data-status="En cours" role="tab" aria-selected="false">{{ t .T "mobile.manga_phys.tab.watching" }}</button>
                    <button type="button" class="mobile-collection-tab" data-status="À lire" role="tab" aria-selected="false">{{ t .T "mobile.manga_phys.tab.plan" }}</button>
                </div>
                <button type="button" class="mobile-filters-btn" id="mobile-manga-phys-filters-open" aria-haspopup="dialog" aria-label="{{ t .T "mobile.filters.button" }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="12" y1="18" x2="20" y2="18"/></svg>
                    <span class="mobile-filters-badge" id="mobile-manga-phys-filters-badge" hidden>0</span>
                </button>
            </div>

            <p class="mobile-collection-summary" id="mobile-manga-phys-summary" data-label-works="{{ if .ActiveSeries }}{{ t .T "manga_phys.series.albums" }}{{ else }}{{ t .T "manga_phys.series.label" }}{{ end }}">
                {{ if .ActiveSeries }}{{ len .Works }} {{ t .T "manga_phys.series.albums" }}{{ else }}{{ len .Series }} {{ t .T "manga_phys.series.label" }}{{ end }}
            </p>

            {{ if .ActiveSeries }}
            <p style="margin:0 0 0.75rem;">
                <a href="{{ manga_phys_dash_url .SortBy .AdultFilter "" }}" style="color:var(--primary);text-decoration:none;">← {{ t .T "manga_phys.series.back" }}</a>
                <strong style="margin-left:0.5rem;">{{ .ActiveSeries }}</strong>
            </p>
            {{ end }}

            <div id="mobile-manga-phys-container">
            {{ if or .Works .Series }}
            {{ template "mobile_manga_phys_list" . }}
            {{ else }}
            <section class="mobile-panel mobile-empty-state">
                <div class="mobile-empty-icon" aria-hidden="true" style="font-size:2.5rem;">📘</div>
                <h2>{{ t .T "manga_phys.dashboard.empty" }}</h2>
                <p>{{ t .T "manga_phys.subtitle" }}</p>
                <a href="/manga-phys/add_work" class="btn btn-primary mobile-empty-cta">{{ t .T "manga_phys.dashboard.empty.cta" }}</a>
            </section>
            {{ end }}
            </div>
        </div>
    </main>

    <div class="mobile-sheet-overlay" id="mobile-manga-phys-filters-overlay" hidden></div>
    <div class="mobile-sheet mobile-filters-sheet" id="mobile-manga-phys-filters-sheet" role="dialog" aria-labelledby="mobile-manga-phys-filters-title" hidden>
        <div class="mobile-sheet-handle" aria-hidden="true"></div>
        <h2 class="mobile-sheet-title" id="mobile-manga-phys-filters-title">{{ t .T "mobile.filters.title" }}</h2>
        <div class="mobile-sheet-section">
            <label class="mobile-sheet-label" for="mobile-manga-phys-filter-status">{{ t .T "manga_phys.form.status" }}</label>
            <select id="mobile-manga-phys-filter-status" class="mobile-sheet-select" autocomplete="off">
                <option value="">{{ t .T "dashboard.filter.all" }}</option>
                {{ range .BdStatuses }}
                <option value="{{ . }}">{{ translateStatus . $.T }}</option>
                {{ end }}
            </select>
        </div>
        <div class="mobile-sheet-section">
            <label class="mobile-sheet-label" for="mobile-manga-phys-sort">{{ t .T "dashboard.sort" }}</label>
            <select id="mobile-manga-phys-sort" class="mobile-sheet-select" autocomplete="off">
                <option value="title" {{ if eq .SortBy "title" }}selected{{ end }}>{{ t .T "manga_phys.sort.title" }}</option>
                <option value="title_desc" {{ if eq .SortBy "title_desc" }}selected{{ end }}>{{ t .T "manga_phys.sort.title_desc" }}</option>
                <option value="status" {{ if eq .SortBy "status" }}selected{{ end }}>{{ t .T "manga_phys.sort.status" }}</option>
                <option value="type" {{ if eq .SortBy "type" }}selected{{ end }}>{{ t .T "manga_phys.sort.type" }}</option>
                <option value="recent" {{ if eq .SortBy "recent" }}selected{{ end }}>{{ t .T "manga_phys.sort.recent" }}</option>
                <option value="modified_desc" {{ if eq .SortBy "modified_desc" }}selected{{ end }}>{{ t .T "manga_phys.sort.modified" }}</option>
            </select>
        </div>
        <div class="mobile-sheet-section mobile-sheet-checks">
            <label class="mobile-filter-check">
                <input type="checkbox" id="mobile-manga-phys-adult-only-check" {{ if eq .AdultFilter "only" }}checked{{ end }}>
                <span>{{ t .T "dashboard.filter.only_adult" }}</span>
            </label>
        </div>
        <button type="button" class="btn btn-primary mobile-sheet-apply" id="mobile-manga-phys-filters-apply">{{ t .T "mobile.filters.apply" }}</button>
        <button type="button" class="mobile-sheet-close" id="mobile-manga-phys-filters-close">{{ t .T "common.close" }}</button>
    </div>

    {{ template "mobile_settings_sheet" . }}
    {{ template "mobile_install_banner" . }}
    {{ template "mobile_bottom_nav" . }}
    {{ template "mobile_shell_scripts" . }}
    <script src="/static/js/mobile-manga-phys-dashboard.js?v=3"></script>
</body>
</html>
{{ end }}
