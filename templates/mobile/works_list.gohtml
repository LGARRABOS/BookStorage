{{ define "mobile_works_list" }}
{{ if .Works }}
<section class="works-mobile-list" id="works-mobile-list">
    {{ range .Works }}
    <a href="/work/{{ .ID }}" class="work-mobile-row" data-work-id="{{ .ID }}" data-title="{{ .Title }}" data-chapter="{{ .Chapter }}" data-status="{{ if .Status.Valid }}{{ .Status.String }}{{ end }}" data-type="{{ if .ReadingType.Valid }}{{ .ReadingType.String }}{{ end }}" data-notify-new-chapters="{{ .NotifyNewChapters }}" data-reading-site-id="{{ if .ReadingSiteID.Valid }}{{ .ReadingSiteID.Int64 }}{{ else }}none{{ end }}">
        <div class="work-mobile-cover">
            {{ $anilistCover := index $.AnilistCoverByWorkID .ID }}
            {{ if $anilistCover }}
                {{ $imgUrl := work_image_url $anilistCover }}
                {{ if $imgUrl }}
                    <img src="{{ $imgUrl }}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="no-image" style="display:none;" aria-hidden="true">📖</span>
                {{ else }}
                    <span class="no-image" aria-hidden="true">📖</span>
                {{ end }}
            {{ else if .ImagePath.Valid }}
                {{ $imgUrl := work_image_url .ImagePath.String }}
                {{ if $imgUrl }}
                    <img src="{{ $imgUrl }}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="no-image" style="display:none;" aria-hidden="true">📖</span>
                {{ else }}
                    <span class="no-image" aria-hidden="true">📖</span>
                {{ end }}
            {{ else }}
                {{ $extCover := index $.CatalogCoverByWorkID .ID }}
                {{ if $extCover }}
                    <img src="{{ $extCover }}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <span class="no-image" style="display:none;" aria-hidden="true">📖</span>
                {{ else }}
                    <span class="no-image" aria-hidden="true">📖</span>
                {{ end }}
            {{ end }}
        </div>
        <div class="work-mobile-row-text">
            <h2 class="work-mobile-title">{{ .Title }}</h2>
            <p class="work-mobile-meta">
                <span>{{ .Chapter }} {{ t $.T "mobile.work.chapters_short" }}</span>
                {{ if .Status.Valid }}<span class="work-mobile-meta-sep" aria-hidden="true">•</span><span>{{ translateStatus .Status.String $.T }}</span>{{ end }}
            </p>
        </div>
        <span class="work-mobile-chevron" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
    </a>
    {{ end }}
</section>
{{ end }}
{{ end }}
