{{ define "edit_bd_form" }}
<form method="POST" enctype="multipart/form-data" id="bd-form" action="/bd/edit/{{ .Work.ID }}">
    {{ template "bd_form_fields" . }}
    <div class="form-actions">
        <a href="/bd/dashboard" class="btn btn-secondary">{{ t .T "common.cancel" }}</a>
        <div class="form-actions-right">
            <button type="button" class="btn btn-danger" id="bd-delete-btn" data-id="{{ .Work.ID }}" data-title="{{ .Work.Title }}">🗑️ {{ t .T "common.delete" }}</button>
            <button type="submit" class="btn btn-primary">✓ {{ t .T "bd.form.submit.save" }}</button>
        </div>
    </div>
</form>
{{ end }}
