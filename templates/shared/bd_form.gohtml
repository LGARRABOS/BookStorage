{{ define "bd_form_styles" }}
<style>
    .form-page { max-width: 820px; margin: 0 auto; }
    .form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .form-header-title h1 { font-size: 1.5rem; display: flex; align-items: center; gap: 0.5rem; margin: 0; }
    .form-card { background: var(--surface); border-radius: 1.25rem; padding: 1.75rem; border: 1px solid var(--border-subtle); margin-bottom: 1.5rem; }
    .form-card-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); }
    .form-card-header .icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .form-card-header .icon.blue { background: rgba(56, 189, 248, 0.15); }
    .form-card-header .icon.purple { background: rgba(129, 140, 248, 0.15); }
    .form-card-header .icon.orange { background: rgba(251, 146, 60, 0.15); }
    .form-card-header h2 { font-size: 1.1rem; font-weight: 600; margin: 0; }
    .form-card-header span { font-size: 0.85rem; color: var(--text-muted); }
    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-group:last-child { margin-bottom: 0; }
    .form-group label { display: block; font-weight: 500; color: var(--text-secondary); margin-bottom: 0.5rem; font-size: 0.9rem; }
    .form-group label .required { color: #ef4444; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-subtle); border-radius: 0.75rem; font-size: 1rem; background: var(--background); color: var(--text-primary); }
    .form-group input[type="checkbox"] { width: auto; height: 1.125rem; accent-color: var(--primary); }
    .form-group textarea { resize: vertical; min-height: 100px; }
    .form-hint { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem; }
    .check-line { display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-weight: 400; }
    .star-rating-picker { display: flex; align-items: center; gap: 0.5rem; }
    .star-rating-picker .stars { display: flex; gap: 0.25rem; }
    .star-rating-picker .star { font-size: 1.75rem; color: #d1d5db; cursor: pointer; user-select: none; }
    .star-rating-picker .star.active { color: #fbbf24; }
    .star-rating-picker .clear-btn { padding: 0.4rem 0.75rem; border: 1px solid var(--border-subtle); border-radius: 0.5rem; background: var(--background); color: var(--text-muted); font-size: 0.8rem; cursor: pointer; }
    .image-upload-area { border: 2px dashed var(--border-subtle); border-radius: 1rem; padding: 1.5rem; text-align: center; cursor: pointer; }
    .image-upload-area:hover { border-color: var(--primary); }
    .image-upload-area input[type="file"] { display: none; }
    .image-preview { margin-top: 1rem; display: none; }
    .image-preview img { max-width: 150px; max-height: 200px; border-radius: 0.75rem; object-fit: cover; }
    .form-actions { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 0.5rem; }
    .form-alert { padding: 0.85rem 1rem; border-radius: 0.75rem; margin-bottom: 1.25rem; font-size: 0.95rem; }
    .form-alert--error { background: rgba(239, 68, 68, 0.12); color: #b91c1c; border: 1px solid rgba(239, 68, 68, 0.35); }
    [data-theme="dark"] .form-alert--error { background: rgba(239, 68, 68, 0.18); color: #fca5a5; border-color: rgba(239, 68, 68, 0.4); }
    .catalog-results { margin-top: 0.75rem; display: none; max-height: 280px; overflow-y: auto; border: 1px solid var(--border-subtle); border-radius: 0.75rem; background: var(--background); }
    .catalog-results.visible { display: block; }
    .catalog-result-item { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-subtle); cursor: pointer; }
    .catalog-result-item:last-child { border-bottom: none; }
    .catalog-result-item:hover { background: var(--primary-muted); }
    .catalog-result-item.is-in-library { cursor: default; opacity: 0.72; }
    .catalog-result-item.is-in-library:hover { background: transparent; }
    .catalog-result-item img { width: 44px; height: 64px; object-fit: cover; border-radius: 0.5rem; }
    .catalog-result-item .no-cover { width: 44px; height: 64px; background: var(--border-subtle); border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .catalog-result-item .info { flex: 1; min-width: 0; }
    .catalog-result-item .info strong { display: block; color: var(--text-primary); }
    .catalog-result-item .info span { font-size: 0.85rem; color: var(--text-muted); }
    .catalog-result-item .badge { font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 999px; background: rgba(129, 140, 248, 0.2); color: var(--primary); }
    .catalog-result-item .badge.in-library { background: rgba(100, 116, 139, 0.25); color: var(--text-muted); }
    [data-theme="dark"] .form-card { background: rgba(51, 65, 85, 0.6); border-color: rgba(100, 116, 139, 0.3); }
    [data-theme="dark"] .star-rating-picker .star { color: #475569; }
</style>
{{ end }}

{{ define "bd_form_fields" }}
{{ $rating := 0 }}{{ if .Work }}{{ $rating = .Work.Rating }}{{ end }}
<div class="form-card">
    <div class="form-card-header">
        <div class="icon blue">📘</div>
        <div><h2>{{ t .T "bd.section.info" }}</h2></div>
    </div>
    <div class="form-group">
        <label for="title">{{ t .T "bd.form.title" }} <span class="required">*</span></label>
        <input id="title" type="text" name="title" required placeholder="{{ t .T "bd.form.title.placeholder" }}" value="{{ if .Work }}{{ .Work.Title }}{{ else }}{{ with .PrefillTitle }}{{ . }}{{ end }}{{ end }}">
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="tome">{{ t .T "bd.form.tome" }}</label>
            <input id="tome" type="number" name="tome" min="0" value="{{ if .Work }}{{ .Work.Tome }}{{ else }}0{{ end }}">
        </div>
        <div class="form-group">
            <label for="total_tomes">{{ t .T "bd.form.total_tomes" }}</label>
            <input id="total_tomes" type="number" name="total_tomes" min="0" placeholder="?" value="{{ if .Work }}{{ if .Work.TotalTomes.Valid }}{{ .Work.TotalTomes.Int64 }}{{ end }}{{ else }}{{ with .PrefillTotalTomes }}{{ if gt . 0 }}{{ . }}{{ end }}{{ end }}{{ end }}">
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="status">{{ t .T "bd.form.status" }}</label>
            <select id="status" name="status">{{ range .Statuses }}<option value="{{ . }}" {{ if $.Work }}{{ if eq . $.Work.Status.String }}selected{{ end }}{{ else if eq . $.DefaultStatus }}selected{{ end }}>{{ translateStatus . $.T }}</option>{{ end }}</select>
        </div>
        <div class="form-group">
            <label for="bd_type">{{ t .T "bd.form.type" }}</label>
            <select id="bd_type" name="bd_type">{{ range .BdTypes }}<option value="{{ . }}" {{ if $.Work }}{{ if eq . $.Work.BdType.String }}selected{{ end }}{{ else if and $.PrefillBdType (eq . $.PrefillBdType) }}selected{{ end }}>{{ . }}</option>{{ end }}</select>
        </div>
    </div>
    <div class="form-group">
        <label class="check-line" for="is_adult">
            <input id="is_adult" type="checkbox" name="is_adult" value="1" {{ if .Work }}{{ if eq .Work.IsAdult.Int64 1 }}checked{{ end }}{{ else if .PrefillIsAdult }}checked{{ end }}>
            <span>{{ t .T "bd.form.adult" }}</span>
        </label>
    </div>
</div>

<div class="form-card">
    <div class="form-card-header">
        <div class="icon purple">🔗</div>
        <div><h2>{{ t .T "bd.section.media" }}</h2></div>
    </div>
    <div class="form-group">
        <label for="link">{{ t .T "bd.form.link" }}</label>
        <input id="link" type="url" name="link" placeholder="https://..." value="{{ if .Work }}{{ .Work.Link.String }}{{ end }}">
    </div>
    {{ if .CatalogPageURL }}<p class="form-hint"><a href="{{ .CatalogPageURL }}" target="_blank" rel="noopener">openlibrary ↗</a></p>{{ end }}
    <div class="form-group">
        <label for="image_url">{{ t .T "bd.form.image_url" }}</label>
        <input id="image_url" type="url" name="image_url" placeholder="https://example.com/cover.jpg" value="{{ if .Work }}{{ if hasPrefix .Work.ImagePath.String "http" }}{{ .Work.ImagePath.String }}{{ end }}{{ else }}{{ with .PrefillImageURL }}{{ . }}{{ end }}{{ end }}" onchange="previewImageUrl(this)">
    </div>
    <div class="form-group">
        <label>{{ t .T "bd.form.upload" }}</label>
        <div class="image-upload-area" onclick="document.getElementById('image').click()">
            <div style="font-size:2rem;opacity:0.5;">🖼️</div>
            <p style="color:var(--text-muted);margin:0.5rem 0 0;">{{ t .T "bd.form.upload.click" }}</p>
            <input id="image" type="file" name="image" accept="image/*" onchange="previewImage(this)">
        </div>
        <div class="image-preview" id="image-preview"><img src="" alt=""></div>
    </div>
</div>

<div class="form-card">
    <div class="form-card-header">
        <div class="icon orange">⭐</div>
        <div><h2>{{ t .T "bd.section.rating" }}</h2></div>
    </div>
    <div class="form-group">
        <label>{{ t .T "bd.form.rating" }}</label>
        <div class="star-rating-picker" id="star-picker">
            <input type="hidden" name="rating" id="rating-value" value="{{ $rating }}">
            <div class="stars">
                {{ range $i := seq 5 }}<span class="star {{ if ge $rating $i }}active{{ end }}" data-value="{{ $i }}">★</span>{{ end }}
            </div>
            <button type="button" class="clear-btn" onclick="clearRating()">{{ t .T "bd.form.rating.clear" }}</button>
        </div>
    </div>
    <div class="form-group">
        <label for="notes">{{ t .T "bd.form.notes" }}</label>
        <textarea id="notes" name="notes" placeholder="{{ t .T "bd.form.notes.placeholder" }}">{{ if .Work }}{{ .Work.Notes.String }}{{ else }}{{ with .PrefillNotes }}{{ . }}{{ end }}{{ end }}</textarea>
    </div>
</div>
{{ end }}

{{ define "bd_form_scripts" }}
<script nonce="{{ .CSPNonce }}">
    function previewImage(input) {
        var preview = document.getElementById('image-preview');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) { preview.querySelector('img').src = e.target.result; preview.style.display = 'block'; };
            reader.readAsDataURL(input.files[0]);
            document.getElementById('image_url').value = '';
        }
    }
    function previewImageUrl(input) {
        var preview = document.getElementById('image-preview');
        if (input.value) {
            preview.querySelector('img').src = input.value;
            preview.style.display = 'block';
            document.getElementById('image').value = '';
        } else {
            preview.style.display = 'none';
        }
    }
    function clearRating() {
        document.getElementById('rating-value').value = '0';
        document.querySelectorAll('#star-picker .star').forEach(function(s) { s.classList.remove('active'); });
    }
    document.addEventListener('DOMContentLoaded', function() {
        var picker = document.getElementById('star-picker');
        if (!picker) return;
        var input = document.getElementById('rating-value');
        var stars = picker.querySelectorAll('.star');
        function updateStars(r) { stars.forEach(function(s, i) { s.classList.toggle('active', i < r); }); }
        stars.forEach(function(star) {
            star.addEventListener('click', function() { input.value = this.dataset.value; updateStars(parseInt(this.dataset.value, 10)); });
            star.addEventListener('mouseenter', function() { updateStars(parseInt(this.dataset.value, 10)); });
        });
        picker.addEventListener('mouseleave', function() { updateStars(parseInt(input.value, 10) || 0); });
        var urlPre = document.getElementById('image_url');
        if (urlPre && urlPre.value) previewImageUrl(urlPre);
    });
</script>
{{ end }}
